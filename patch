# Direct patch to add temp cleanup after successful upload
import os

main_path = "/content/TeraboxUploaderCLI/main.py"

with open(main_path, 'r') as f:
    content = f.read()

# Find and replace the exact line
old_line = '    fmt.success("upload", f"File {display_local} concluded every upload procedure.")'

new_code = '''    fmt.success("upload", f"File {display_local} concluded every upload procedure.")
    
    # Clean up temp chunks for this file
    if os.path.exists(TEMP_DIR):
        for item in os.listdir(TEMP_DIR):
            try:
                item_path = os.path.join(TEMP_DIR, item)
                if os.path.isfile(item_path):
                    os.remove(item_path)
                    fmt.debug("cleanup", f"Deleted temp file: {item}")
            except Exception as e:
                fmt.warning("cleanup", f"Failed to delete {item}: {e}")'''

if old_line in content and "# Clean up temp chunks" not in content:
    content = content.replace(old_line, new_code)
    
    with open(main_path, 'w') as f:
        f.write(content)
    
    print("✓ Patch applied successfully!")
else:
    if "# Clean up temp chunks" in content:
        print("Already patched")
    else:
        print("Could not find the target line to patch")
